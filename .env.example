PORT=3001
# Provide a Groq key (gsk_...), NVIDIA NIM key (nvapi-...), or Google Gemini key (AIza...)
AI_API_KEY=
# Model examples:
# Groq: openai/gpt-oss-120b (recommended ultra-fast ~1s inference)
# NVIDIA: meta/llama-3.2-11b-vision-instruct
# Gemini: gemini-2.0-flash
AI_MODEL=openai/gpt-oss-120b
# Optional: Firebase Realtime Database URL for data persistence
FIREBASE_DATABASE_URL=https://revenuecertificationmonitoring-default-rtdb.firebaseio.com/
